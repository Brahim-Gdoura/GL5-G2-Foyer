pipeline {
    agent any

    environment {
        AWS_REGION = 'us-east-1'
        PROJECT_NAME = 'k3s-nginx-jenkins'
        TERRAFORM_DIR = 'awstest/terraform'
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials')
        DOCKER_IMAGE = 'mohamedaminelili02/my-app:latest'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'feature/ReadMeInit',
                    url: 'https://github.com/Brahim-Gdoura/GL5-G2-Foyer.git'
            }
        }

        // Maven Build & Test
        stage('Maven Build') {
            steps {
                sh 'mvn clean compile -f pom.xml'
            }
        }

        stage('Maven Test') {
            steps {
                sh 'mvn test -f pom.xml'
            }
        }

        stage('Maven Package') {
            steps {
                sh 'mvn package -f pom.xml -DskipTests'
            }
        }

        // Terraform
        stage('Validate Terraform') {
            steps {
                dir(env.TERRAFORM_DIR) {
                    sh '''
                        terraform validate
                        terraform fmt -check
                    '''
                }
            }
        }

        stage('Terraform Init') {
            steps {
                dir(env.TERRAFORM_DIR) {
                    withCredentials([
                        string(credentialsId: 'AWS_ACCESS_KEY_ID', variable: 'AWS_ACCESS_KEY'),
                        string(credentialsId: 'AWS_SECRET_ACCESS_KEY', variable: 'AWS_SECRET_KEY'),
                        string(credentialsId: 'AWS_SESSION_TOKEN', variable: 'AWS_SESSION_TOKEN')
                    ]) {
                        sh '''
                            export AWS_ACCESS_KEY_ID="$AWS_ACCESS_KEY"
                            export AWS_SECRET_ACCESS_KEY="$AWS_SECRET_KEY"
                            export AWS_SESSION_TOKEN="$AWS_SESSION_TOKEN"

                            terraform init -upgrade
                        '''
                    }
                }
            }
        }

        stage('Terraform Plan & Apply') {
            steps {
                dir(env.TERRAFORM_DIR) {
                    withCredentials([
                        string(credentialsId: 'AWS_ACCESS_KEY_ID', variable: 'AWS_ACCESS_KEY'),
                        string(credentialsId: 'AWS_SECRET_ACCESS_KEY', variable: 'AWS_SECRET_KEY'),
                        string(credentialsId: 'AWS_SESSION_TOKEN', variable: 'AWS_SESSION_TOKEN')
                    ]) {
                        sh '''
                            export AWS_ACCESS_KEY_ID="$AWS_ACCESS_KEY"
                            export AWS_SECRET_ACCESS_KEY="$AWS_SECRET_KEY"
                            export AWS_SESSION_TOKEN="$AWS_SESSION_TOKEN"

                            terraform plan -var="aws_region=${AWS_REGION}" \
                                          -var="project_name=${PROJECT_NAME}" \
                                          -var="image_name=${DOCKER_IMAGE}" \
                                          -out=tfplan

                            terraform apply -auto-approve tfplan
                        '''
                    }
                }
            }
        }

        stage('Get Cluster Info') {
            steps {
                dir(env.TERRAFORM_DIR) {
                    withCredentials([
                        string(credentialsId: 'AWS_ACCESS_KEY_ID', variable: 'AWS_ACCESS_KEY'),
                        string(credentialsId: 'AWS_SECRET_ACCESS_KEY', variable: 'AWS_SECRET_KEY'),
                        string(credentialsId: 'AWS_SESSION_TOKEN', variable: 'AWS_SESSION_TOKEN')
                    ]) {
                        sh '''
                            export AWS_ACCESS_KEY_ID="$AWS_ACCESS_KEY"
                            export AWS_SECRET_ACCESS_KEY="$AWS_SECRET_KEY"
                            export AWS_SESSION_TOKEN="$AWS_SESSION_TOKEN"

                            terraform output
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            dir(env.TERRAFORM_DIR) {
                withCredentials([
                    string(credentialsId: 'AWS_ACCESS_KEY_ID', variable: 'AWS_ACCESS_KEY'),
                    string(credentialsId: 'AWS_SECRET_ACCESS_KEY', variable: 'AWS_SECRET_KEY'),
                    string(credentialsId: 'AWS_SESSION_TOKEN', variable: 'AWS_SESSION_TOKEN')
                ]) {
                    sh '''
                        export AWS_ACCESS_KEY_ID="$AWS_ACCESS_KEY"
                        export AWS_SECRET_ACCESS_KEY="$AWS_SECRET_KEY"
                        export AWS_SESSION_TOKEN="$AWS_SESSION_TOKEN"

                        terraform output || true
                    '''
                }
            }

            sh 'docker logout'
        }
        success { echo "✅ Pipeline completed successfully!" }
        failure { echo "❌ Pipeline failed!" }
    }
}
