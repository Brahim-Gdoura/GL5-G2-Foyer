pipeline {
    agent any

    environment {
        AWS_REGION = 'us-east-1'
        PROJECT_NAME = 'k3s-nginx-jenkins'
        TERRAFORM_DIR = 'awstest/terraform'
    }

    stages {

        stage('Maven Build') {
            steps {
                sh '''
                    echo "=== Building with Maven ==="
                    mvn clean compile
                    echo "=== Maven build completed ==="
                '''
            }
        }

        stage('Maven Package') {
            steps {
                sh '''
                    echo "=== Packaging with Maven ==="
                    mvn clean package -DskipTests
                    echo "=== Maven packaging completed ==="
                '''
            }
        }

        stage('Maven Tests') {
            steps {
                sh '''
                    echo "=== Running Maven Tests ==="
                    mvn test
                    echo "=== Maven tests completed ==="
                '''
            }
        }

        // ------------------- Mock Docker Build -------------------
        stage('Docker Build') {
            steps {
                sh '''
                    echo "=== Mocking Docker Build ==="
                    # Random wait between 100ms and 300ms
                    WAIT_MS=$((RANDOM % 201 + 100))
                    echo "Waiting for ${WAIT_MS}ms to simulate Docker build"
                    sleep_time=$(echo "scale=3; ${WAIT_MS}/1000" | awk '{printf "%.3f", $1}')
                    sleep $sleep_time
                    echo "=== Mock Docker Build Completed ==="
                '''
            }
        }

        // ------------------- Mock Docker Deploy -------------------
        stage('Docker Push') {
            steps {
                sh '''
                    echo "=== Mocking Docker Deploy ==="
                    # Random wait between 100ms and 300ms
                    WAIT_MS=$((RANDOM % 201 + 100))
                    echo "Waiting for ${WAIT_MS}ms to simulate Docker deploy"
                    sleep_time=$(echo "scale=3; ${WAIT_MS}/1000" | awk '{printf "%.3f", $1}')
                    sleep $sleep_time
                    echo "=== Mock Docker Deploy Completed ==="
                '''
            }
        }

        // ------------------- Terraform Stages -------------------
        stage('Validate Terraform Syntax') {
            steps {
                dir(env.TERRAFORM_DIR) {
                    withCredentials([
                        string(credentialsId: 'AWS_ACCESS_KEY_ID', variable: 'AWS_ACCESS_KEY_ID'),
                        string(credentialsId: 'AWS_SECRET_ACCESS_KEY', variable: 'AWS_SECRET_ACCESS_KEY'),
                        string(credentialsId: 'AWS_SESSION_TOKEN', variable: 'AWS_SESSION_TOKEN')
                    ]) {
                        sh '''
                            echo "=== Validating Terraform syntax ==="
                            terraform validate
                            terraform fmt -check
                            echo "=== Syntax validation passed ==="
                        '''
                    }
                }
            }
        }

        stage('Terraform Init') {
            steps {
                dir(env.TERRAFORM_DIR) {
                    withCredentials([
                        string(credentialsId: 'AWS_ACCESS_KEY_ID', variable: 'AWS_ACCESS_KEY_ID'),
                        string(credentialsId: 'AWS_SECRET_ACCESS_KEY', variable: 'AWS_SECRET_ACCESS_KEY'),
                        string(credentialsId: 'AWS_SESSION_TOKEN', variable: 'AWS_SESSION_TOKEN')
                    ]) {
                        sh '''
                            echo "=== Initializing Terraform ==="
                            terraform init -upgrade
                        '''
                    }
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir(env.TERRAFORM_DIR) {
                    withCredentials([
                        string(credentialsId: 'AWS_ACCESS_KEY_ID', variable: 'AWS_ACCESS_KEY_ID'),
                        string(credentialsId: 'AWS_SECRET_ACCESS_KEY', variable: 'AWS_SECRET_ACCESS_KEY'),
                        string(credentialsId: 'AWS_SESSION_TOKEN', variable: 'AWS_SESSION_TOKEN')
                    ]) {
                        sh '''
                            terraform plan -var="aws_region=${AWS_REGION}" \
                                          -var="project_name=${PROJECT_NAME}" \
                                          -var="app_name=my-app" \
                                          -var="app_port=8082" \
                                          -out=tfplan
                        '''
                    }
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                dir(env.TERRAFORM_DIR) {
                    withCredentials([
                        string(credentialsId: 'AWS_ACCESS_KEY_ID', variable: 'AWS_ACCESS_KEY_ID'),
                        string(credentialsId: 'AWS_SECRET_ACCESS_KEY', variable: 'AWS_SECRET_ACCESS_KEY'),
                        string(credentialsId: 'AWS_SESSION_TOKEN', variable: 'AWS_SESSION_TOKEN')
                    ]) {
                        sh '''
                            terraform apply -auto-approve tfplan
                            sleep 30
                        '''
                    }
                }
            }
        }

        stage('Get Cluster Info') {
            steps {
                dir(env.TERRAFORM_DIR) {
                    withCredentials([
                        string(credentialsId: 'AWS_ACCESS_KEY_ID', variable: 'AWS_ACCESS_KEY_ID'),
                        string(credentialsId: 'AWS_SECRET_ACCESS_KEY', variable: 'AWS_SECRET_ACCESS_KEY'),
                        string(credentialsId: 'AWS_SESSION_TOKEN', variable: 'AWS_SESSION_TOKEN')
                    ]) {
                        sh '''
                            echo "=== K3s Cluster Information ==="
                            terraform output || echo "No outputs available yet"
                            terraform show -json | jq -r '.values.root_module.resources[] | select(.type=="aws_instance") | .values.public_ip' || echo "No instance found in state"
                        '''
                    }
                }
            }
        }

        // ------------------- Terraform Destroy -------------------
        stage('Terraform Destroy') {
            steps {
                dir(env.TERRAFORM_DIR) {
                    withCredentials([
                        string(credentialsId: 'AWS_ACCESS_KEY_ID', variable: 'AWS_ACCESS_KEY_ID'),
                        string(credentialsId: 'AWS_SECRET_ACCESS_KEY', variable: 'AWS_SECRET_ACCESS_KEY'),
                        string(credentialsId: 'AWS_SESSION_TOKEN', variable: 'AWS_SESSION_TOKEN')
                    ]) {
                        sh '''
                            echo "=== Destroying Terraform Resources ==="
                            terraform destroy -auto-approve
                            echo "=== Terraform Destroy Completed ==="
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            dir(env.TERRAFORM_DIR) {
                withCredentials([
                    string(credentialsId: 'AWS_ACCESS_KEY_ID', variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'AWS_SECRET_ACCESS_KEY', variable: 'AWS_SECRET_ACCESS_KEY'),
                    string(credentialsId: 'AWS_SESSION_TOKEN', variable: 'AWS_SESSION_TOKEN')
                ]) {
                    sh '''
                        echo "=== Final Terraform State Check ==="
                        terraform state list || echo "No resources in state"
                        terraform output 2>/dev/null || echo "No outputs available"
                        echo "=== Created Resources ==="
                        terraform show -no-color | grep -E "(aws_instance|public_ip|tags)" || echo "No resource details available"
                    '''
                }
            }
        }
        success {
            echo "✅ Pipeline completed successfully!"
        }
        failure {
            echo "❌ Pipeline failed - check the logs above for details"
        }
    }
}
