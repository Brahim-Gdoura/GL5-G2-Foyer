pipeline {
    agent any

    environment {
        AWS_REGION = 'us-east-1'
        PROJECT_NAME = 'k3s-nginx-jenkins'
        TERRAFORM_DIR = 'awstest/terraform'
        DOCKER_IMAGE = 'mohamedaminelili02/my-app:latest'
        SSH_CREDENTIALS_ID = 'jenkins-ec2-key' // SSH private key credential in Jenkins
    }

    stages {

        stage('Maven Build & Package') {
            steps {
                sh '''
                    echo "=== Maven Build ==="
                    mvn clean compile package -DskipTests
                '''
            }
        }

        stage('Run Maven Tests') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Docker Build & Push') {
            steps {
                withCredentials([string(credentialsId: 'dockerhub-credentials', variable: 'DOCKER_TOKEN')]) {
                    sh """
                        echo "=== Docker Build ==="
                        docker build -t ${DOCKER_IMAGE} .
                        echo "=== Docker Login ==="
                        echo \$DOCKER_TOKEN | docker login -u mohamedaminelili02 --password-stdin
                        docker push ${DOCKER_IMAGE}
                        docker logout
                    """
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                dir(env.TERRAFORM_DIR) {
                    withCredentials([
                        string(credentialsId: 'AWS_ACCESS_KEY_ID', variable: 'AWS_ACCESS_KEY_ID'),
                        string(credentialsId: 'AWS_SECRET_ACCESS_KEY', variable: 'AWS_SECRET_ACCESS_KEY'),
                        string(credentialsId: 'AWS_SESSION_TOKEN', variable: 'AWS_SESSION_TOKEN')
                    ]) {
                        sh '''
                            terraform init -upgrade
                            terraform plan -var="aws_region=${AWS_REGION}" -var="project_name=${PROJECT_NAME}" -out=tfplan
                            terraform apply -auto-approve tfplan
                        '''
                    }
                }
            }
        }

        stage('Get EC2 Public IP') {
            steps {
                dir(env.TERRAFORM_DIR) {
                    script {
                        env.EC2_IP = sh(script: "terraform output -raw k3s_master_public_ip", returnStdout: true).trim()
                        echo "EC2 Public IP: ${env.EC2_IP}"
                    }
                }
            }
        }

        stage('Run Spring Boot on EC2') {
            steps {
                sshagent([env.SSH_CREDENTIALS_ID]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ubuntu@${env.EC2_IP} '
                            docker pull ${DOCKER_IMAGE}
                            docker stop my-app || true
                            docker rm my-app || true
                            docker run -d --name my-app -p 8082:8082 ${DOCKER_IMAGE}
                        '
                    """
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                sh """
                    echo "=== Checking App Endpoint ==="
                    curl -f http://${env.EC2_IP}:8082/api/univeristes/getAll || echo "App endpoint not reachable yet"
                """
            }
        }

        stage('Terraform Destroy') {
            steps {
                dir(env.TERRAFORM_DIR) {
                    sh 'terraform destroy -auto-approve'
                }
            }
        }
    }

    post {
        always {
            dir(env.TERRAFORM_DIR) {
                sh 'terraform state list || echo "No resources in state"'
            }
        }
        success { echo "✅ Pipeline completed successfully!" }
        failure { echo "❌ Pipeline failed - check logs above!" }
    }
}
