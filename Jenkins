pipeline {
    agent any

    tools {
        // Make sure these tools are configured in Jenkins (Manage Jenkins > Global Tool Configuration)
        maven 'Maven3'        // Replace with your Maven installation name
        jdk 'JDK17'           // Replace with your JDK installation name
    }

    environment {
        MAVEN_OPTS = "-Dmaven.test.failure.ignore=false"
    }

    stages {

        stage('Checkout') {
            steps {
                echo '🔹 Checking out source code...'
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                echo '🔹 Building and running tests...'
                bat 'mvn clean verify'
            }
        }

        stage('Test Results') {
            steps {
                echo '🔹 Publishing test results...'
                junit '**/target/surefire-reports/*.xml'
            }
        }

        stage('Code Coverage (JaCoCo)') {
            steps {
                echo '🔹 Publishing JaCoCo report...'
                jacoco execPattern: '**/target/jacoco.exec',
                       classPattern: '**/target/classes',
                       sourcePattern: '**/src/main/java',
                       exclusionPattern: ''
            }
        }

    }

    post {
        success {
            echo '✅ Build and tests passed successfully!'
        }
        failure {
            echo '❌ Build or tests failed.'
        }
        always {
            echo '📦 Cleaning up workspace...'
            cleanWs()
        }
    }
}
