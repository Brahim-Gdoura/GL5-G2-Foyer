pipeline {
    agent any

    environment {
        AWS_REGION = 'us-east-1'
        PROJECT_NAME = 'k3s-nginx-jenkins'
        TERRAFORM_DIR = 'awstest/terraform'
    }

    stages {

        // ------------------------------------------------------
        // GIT CHECKOUT
        // ------------------------------------------------------
        stage('Checkout') {
            steps {
                git branch: 'feature/ReadMeInit',
                    url: 'https://github.com/Brahim-Gdoura/GL5-G2-Foyer.git'
            }
        }

        // ------------------------------------------------------
        // DOCKER BUILD & DEPLOY (Before Terraform)
        // ------------------------------------------------------
        stage('Fake Docker Build') {
            steps {
                script {
                    def t = (100 + new Random().nextInt(201)) / 1000.0
                    echo "=== Fake Docker Build (sleep ${t}s) ==="
                    sh "sleep ${t}"
                    echo "=== Fake Docker Build Completed ==="
                }
            }
        }

        stage('Fake Docker Deploy') {
            steps {
                script {
                    def t = (100 + new Random().nextInt(201)) / 1000.0
                    echo "=== Fake Docker Deploy (sleep ${t}s) ==="
                    sh "sleep ${t}"
                    echo "=== Fake Docker Deploy Completed ==="
                }
            }
        }

        // ------------------------------------------------------
        // MAVEN PIPELINE
        // ------------------------------------------------------
        stage('Maven Build') {
            steps {
                sh '''
                    echo "=== Running mvn clean compile ==="
                    mvn clean compile
                '''
            }
        }

        stage('Maven Package') {
            steps {
                sh '''
                    echo "=== Running mvn package ==="
                    mvn clean package -DskipTests
                '''
            }
        }

        stage('Maven Tests') {
            steps {
                sh '''
                    echo "=== Running tests ==="
                    mvn test
                '''
            }
        }

        // ------------------------------------------------------
        // TERRAFORM - shared credentials export
        // ------------------------------------------------------
        stage('Terraform Init') {
            steps {
                dir(env.TERRAFORM_DIR) {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'aws-credentials',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]) {
                        sh '''
                            echo "=== Initializing Terraform ==="
                            export AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID
                            export AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY
                            export AWS_REGION=${AWS_REGION}

                            terraform init -upgrade
                        '''
                    }
                }
            }
        }

        stage('Validate Terraform Syntax') {
            steps {
                dir(env.TERRAFORM_DIR) {
                    sh '''
                        echo "=== Validating Terraform ==="
                        terraform validate
                        terraform fmt -check
                    '''
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir(env.TERRAFORM_DIR) {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'aws-credentials',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]) {
                        sh '''
                            export AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID
                            export AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY
                            export AWS_REGION=${AWS_REGION}

                            terraform plan \
                                -var="aws_region=${AWS_REGION}" \
                                -var="project_name=${PROJECT_NAME}" \
                                -var="app_name=my-app" \
                                -var="app_port=8082" \
                                -out=tfplan
                        '''
                    }
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                dir(env.TERRAFORM_DIR) {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'aws-credentials',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]) {
                        sh '''
                            export AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID
                            export AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY
                            export AWS_REGION=${AWS_REGION}

                            terraform apply -auto-approve tfplan
                            sleep 20
                        '''
                    }
                }
            }
        }

        stage('Get Cluster Info') {
            steps {
                dir(env.TERRAFORM_DIR) {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'aws-credentials',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]) {
                        sh '''
                            export AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID
                            export AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY
                            export AWS_REGION=${AWS_REGION}

                            echo "=== Terraform Output ==="
                            terraform output || echo "No outputs"
                        '''
                    }
                }
            }
        }

        // ------------------------------------------------------
        // TERRAFORM DESTROY (End of pipeline)
        // ------------------------------------------------------
        stage('Terraform Destroy') {
            steps {
                dir(env.TERRAFORM_DIR) {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'aws-credentials',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]) {
                        sh '''
                            echo "=== Destroying infrastructure ==="
                            export AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID
                            export AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY
                            export AWS_REGION=${AWS_REGION}

                            terraform destroy -auto-approve
                            echo "=== Destroy completed ==="
                        '''
                    }
                }
            }
        }
    }

    // ------------------------------------------------------
    // POST ACTIONS
    // ------------------------------------------------------
    post {
        always {
            echo "=== Pipeline Finished ==="
        }
        success {
            echo "✅ SUCCESS — Infrastructure destroyed and pipeline finished!"
        }
        failure {
            echo "❌ FAILURE — Check logs!"
        }
    }
}
